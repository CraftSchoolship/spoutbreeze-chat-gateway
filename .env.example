# Chat Gateway Microservice Environment Configuration Example

# This file contains example environment variables for the chat gateway microservice.

# API settings
LOG_LEVEL=

# Twitch settings
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8800/twitch/callback

# YouTube settings
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Redis settings (if using Redis for pub/sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
# Other settings
MESSAGE_QUEUE_TYPE=redis
MESSAGE_QUEUE_URL=redis://localhost:6379/0  # Only if using Redis

CHAT_GATEWAY_SHARED_SECRET=dev-secret

BACKEND_URL=
CHAT_GATEWAY_INTERNAL_URL=

# Database configuration
DB_URL=